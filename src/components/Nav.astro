---
import type { Locale } from '../config/site';
import type { I18nData } from '../content.config';
import { pathFor } from '../lib/i18n';
import LocaleSwitcher from './LocaleSwitcher.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  slug: string;
  t: I18nData;
}

const { locale, slug, t } = Astro.props;
const links = [
  { href: pathFor(locale, 'features'), label: t.nav.features, key: 'features' },
  { href: `${pathFor(locale)}#pricing`, label: t.nav.pricing, key: 'pricing' },
  { href: pathFor(locale, 'faq'), label: t.nav.faq, key: 'faq' },
  { href: pathFor(locale, 'help'), label: t.nav.help, key: 'help' },
  { href: pathFor(locale, 'privacy'), label: t.nav.privacy, key: 'privacy' },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-[color-mix(in_oklab,var(--bg)_82%,transparent)] backdrop-blur-xl backdrop-saturate-150">
  <nav class="container-x h-16 flex items-center justify-between gap-4" aria-label="Main">
    <a href={pathFor(locale)} class="flex items-center gap-2.5 shrink-0" aria-label="MoneyWise home">
      <img src="/app-icon.png" alt="" width="30" height="30" class="rounded-[8px] shadow-[var(--shadow-sm)]" />
      <span class="text-[16px] font-semibold tracking-[-0.01em]">MoneyWise</span>
    </a>

    <div class="hidden lg:flex items-center gap-1 text-[14px]">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={slug === l.key ? 'page' : undefined}
          class={`rounded-full px-3 py-1.5 transition hover:text-fg hover:bg-bg-sunken ${slug === l.key ? 'text-fg font-medium' : 'text-fg-2'}`}
        >{l.label}</a>
      ))}
    </div>

    <div class="hidden lg:flex items-center gap-2">
      <LocaleSwitcher current={locale} slug={slug} />
      <a href={`${pathFor(locale)}#download`} class="btn btn-primary !min-h-0 !py-2 !px-4 text-[14px]">
        {t.nav.download}
      </a>
    </div>

    <div class="flex lg:hidden items-center gap-1">
      <a href={`${pathFor(locale)}#download`} class="btn btn-primary !min-h-0 !py-2 !px-3.5 text-[13px]">{t.nav.download}</a>
      <details class="mobile-menu group">
        <summary
          class="list-none cursor-pointer w-10 h-10 inline-flex items-center justify-center rounded-full text-fg hover:bg-bg-sunken transition [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon name="menu" class="w-5 h-5 group-open:hidden" />
          <Icon name="x" class="w-5 h-5 hidden group-open:block" />
        </summary>
        <div class="absolute inset-x-0 top-16 border-b border-line bg-bg shadow-[var(--shadow-md)] max-h-[calc(100dvh-4rem)] overflow-y-auto">
          <div class="container-x py-3 flex flex-col">
            {links.map((l) => (
              <a href={l.href} class="flex items-center justify-between py-3.5 border-b border-line text-[16px] text-fg">
                {l.label}
                <Icon name="arrow" class="w-4 h-4 text-fg-3" />
              </a>
            ))}
            <div class="py-3">
              <LocaleSwitcher current={locale} slug={slug} />
            </div>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>
