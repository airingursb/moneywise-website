---
/**
 * Download entry points. Two layouts:
 *  - `compact` (hero): two store buttons + a line of direct-download links
 *  - `full` (download band): a card per platform, plus in-development platforms
 * Every link keeps its original `data-umami-event` name.
 */
import type { I18nData } from '../content.config';
import { SITE } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  t: I18nData;
  layout?: 'compact' | 'full';
  /** `ink` = rendered on the dark forest band. */
  tone?: 'default' | 'ink';
  class?: string;
}

const { t, layout = 'full', tone = 'default', class: className = '' } = Astro.props;
const ink = tone === 'ink';

const apple = '<path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>';
const play = '<path d="M3.6 2.3c-.2.2-.3.6-.3 1v17.4c0 .4.1.8.3 1l9.7-9.7zM16.6 15.3l-3.3-3.3 3.3-3.3 3.8 2.1c1.1.6 1.1 1.7 0 2.3zM4.5 22.2c.3.1.7.1 1.1-.1l11-6.3-3.2-3.2zM4.5 1.8l8.9 8.9 3.2-3.2-11-6.2c-.4-.3-.8-.3-1.1-.2z"/>';

const cardBase = 'group relative flex items-center gap-3.5 rounded-2xl px-4 py-3.5 transition';
const cardTone = ink
  ? 'bg-white/[0.06] border border-line-on-ink text-on-ink hover:bg-white/[0.10]'
  : 'bg-bg-elev border border-line text-fg hover:border-line-strong hover:shadow-[var(--shadow-md)]';
const cardPrimary = ink
  ? 'bg-[#F4F7F4] text-[#0F1C14] border border-transparent hover:bg-white'
  : 'bg-fg text-bg border border-transparent hover:opacity-90';
const sub = ink ? 'text-on-ink-2' : 'text-fg-3';
const subPrimary = 'opacity-70';
---

{layout === 'compact' ? (
  <div class={`flex flex-col gap-4 ${className}`}>
    <div class="flex flex-wrap gap-3">
      <a href={SITE.appStoreUrl} data-umami-event="app_store_cta_click" class="btn btn-primary !pl-4 !pr-5">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={apple} />
        <span>{t.platforms.app_store}</span>
      </a>
      <a href={SITE.playStoreUrl} target="_blank" rel="noopener noreferrer" data-umami-event="play_store_cta_click" class="btn btn-ghost !pl-4 !pr-5">
        <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={play} />
        <span>{t.platforms.play_store}</span>
      </a>
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] text-fg-2">
      {SITE.apkDirectAvailable && (
        <a href={SITE.apkDirectUrl} data-umami-event="apk_direct_cta_click" data-android-cta class="android-cta inline-flex items-center gap-1.5 hover:text-fg underline decoration-line-strong underline-offset-4 hover:decoration-current">
          <Icon name="download" class="w-3.5 h-3.5" />{t.platforms.apk_direct}
        </a>
      )}
      {SITE.dmgDirectAvailable && (
        <a href={SITE.dmgDirectUrl} download data-umami-event="mac_dmg_direct_cta_click" class="inline-flex items-center gap-1.5 hover:text-fg underline decoration-line-strong underline-offset-4 hover:decoration-current">
          <Icon name="laptop" class="w-3.5 h-3.5" />{t.platforms.dmg_direct}
        </a>
      )}
    </div>
  </div>
) : (
  <div class={`w-full ${className}`}>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <a href={SITE.appStoreUrl} data-umami-event="app_store_cta_click" class={`${cardBase} ${cardPrimary}`}>
        <svg class="w-7 h-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={apple} />
        <span class="flex-1 min-w-0 text-left">
          <span class="block font-semibold text-[15px] leading-tight">{t.platforms.app_store}</span>
          <span class={`block mt-0.5 text-[12.5px] ${subPrimary}`}>{t.platforms.status_available}</span>
        </span>
        <Icon name="arrow" class="w-4 h-4 opacity-60 transition group-hover:translate-x-0.5" />
      </a>

      <a href={SITE.playStoreUrl} target="_blank" rel="noopener noreferrer" data-umami-event="play_store_cta_click" class={`${cardBase} ${cardTone}`}>
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={play} />
        <span class="flex-1 min-w-0 text-left">
          <span class="block font-semibold text-[15px] leading-tight">{t.platforms.play_store}</span>
          <span class={`block mt-0.5 text-[12.5px] ${sub}`}>{t.platforms.status_beta}</span>
        </span>
        <Icon name="arrow" class="w-4 h-4 opacity-60 transition group-hover:translate-x-0.5" />
      </a>

      {/*
        Android direct-download (sideload) for users without Play Store access —
        notably mainland China and HMS-only devices (SHU-484). The
        `data-android-cta` hook is used by the inline UA script below.
      */}
      {SITE.apkDirectAvailable && (
        <a href={SITE.apkDirectUrl} data-umami-event="apk_direct_cta_click" data-android-cta class={`${cardBase} ${cardTone} android-cta`}>
          <Icon name="download" class="w-6 h-6 shrink-0" />
          <span class="flex-1 min-w-0 text-left">
            <span class="block font-semibold text-[15px] leading-tight">{t.platforms.apk_direct}</span>
            <span class={`block mt-0.5 text-[12.5px] ${sub}`}>{t.platforms.status_apk_direct}</span>
          </span>
          <Icon name="download" class="w-4 h-4 opacity-60" />
        </a>
      )}

      {SITE.dmgDirectAvailable ? (
        <a href={SITE.dmgDirectUrl} download data-umami-event="mac_dmg_direct_cta_click" class={`${cardBase} ${cardTone}`}>
          <Icon name="laptop" class="w-6 h-6 shrink-0" />
          <span class="flex-1 min-w-0 text-left">
            <span class="block font-semibold text-[15px] leading-tight">{t.platforms.dmg_direct}</span>
            <span class={`block mt-0.5 text-[12.5px] ${sub}`}>{t.platforms.status_dmg_direct}</span>
          </span>
          <Icon name="download" class="w-4 h-4 opacity-60" />
        </a>
      ) : SITE.appStoreMacAvailable ? (
        <a href={SITE.appStoreMacUrl} data-umami-event="mac_app_store_cta_click" class={`${cardBase} ${cardTone}`}>
          <Icon name="laptop" class="w-6 h-6 shrink-0" />
          <span class="flex-1 min-w-0 text-left">
            <span class="block font-semibold text-[15px] leading-tight">{t.platforms.app_store_mac}</span>
            <span class={`block mt-0.5 text-[12.5px] ${sub}`}>{t.platforms.status_available_mac}</span>
          </span>
          <Icon name="arrow" class="w-4 h-4 opacity-60" />
        </a>
      ) : (
        <div class={`${cardBase} ${cardTone} opacity-80 cursor-default`} aria-disabled="true">
          <Icon name="laptop" class="w-6 h-6 shrink-0" />
          <span class="flex-1 min-w-0 text-left">
            <span class="block font-semibold text-[15px] leading-tight">{t.platforms.app_store_mac}</span>
            <span class={`block mt-0.5 text-[12.5px] ${sub}`}>{t.platforms.status_coming_soon}</span>
          </span>
        </div>
      )}
    </div>

    <div class={`mt-4 flex flex-wrap items-center gap-2 text-[13px] ${sub}`}>
      <span class={`inline-flex items-center gap-2 rounded-full px-3 py-1.5 border border-dashed ${ink ? 'border-line-on-ink' : 'border-line-strong'}`}>
        <Icon name="watch" class="w-4 h-4" />{t.platforms.apple_watch} · {t.platforms.status_watch}
      </span>
      <span class={`inline-flex items-center gap-2 rounded-full px-3 py-1.5 border border-dashed ${ink ? 'border-line-on-ink' : 'border-line-strong'}`}>
        <Icon name="phone" class="w-4 h-4" />{t.platforms.ipad} · {t.platforms.status_in_development}
      </span>
    </div>
  </div>
)}

<script is:inline>
  // Highlight the direct-APK CTA on actual Android devices. UA is only a UX
  // hint — the link works for any visitor who clicks it.
  (function () {
    try {
      if (/Android/i.test(navigator.userAgent)) {
        document.querySelectorAll('[data-android-cta]').forEach(function (el) {
          el.classList.add('is-android-ua');
        });
      }
    } catch (_) {}
  })();
</script>

<style is:global>
  .android-cta.is-android-ua {
    box-shadow: 0 0 0 2px var(--accent), 0 6px 20px -8px rgba(0, 0, 0, 0.25);
  }
</style>
