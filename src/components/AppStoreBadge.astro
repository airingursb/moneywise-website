---
import { SITE } from '../config/site';

interface Props {
  variant?: 'primary' | 'light' | 'dark' | 'accent';
  label: string;
  comingSoonLabel: string;
  class?: string;
}

const { variant = 'primary', label, comingSoonLabel, class: className = '' } = Astro.props;
const available = SITE.appStoreAvailable;
const styles = {
  primary: 'btn-primary',
  dark: 'btn-primary',
  light: 'btn-ghost',
  accent: 'btn-accent',
}[variant];
---

{available ? (
  <a href={SITE.appStoreUrl} data-umami-event="app_store_cta_click" class={`btn ${styles} w-full sm:w-auto ${className}`}>
    {label}
    <span aria-hidden="true">→</span>
  </a>
) : (
  <span class={`btn ${styles} opacity-60 cursor-not-allowed ${className}`} title={comingSoonLabel}>
    {comingSoonLabel}
  </span>
)}
