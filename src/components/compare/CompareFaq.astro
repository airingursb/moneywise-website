---
import type { CompareI18nData, CompetitorCopy } from '../../content.config';
import Icon from '../Icon.astro';

interface Props {
  c: CompareI18nData;
  copy: CompetitorCopy;
}
const { c, copy } = Astro.props;
---
<section class="section">
  <div class="container-x max-w-[52rem]">
    <h2 class="t-h2">{c.common.section_titles.faq}</h2>
    <div class="mt-8 border-t border-line">
      {copy.faq.map((item: { q: string; a: string }) => (
        <details class="qa">
          <summary>{item.q}<span class="qa-icon"><Icon name="plus" class="w-3.5 h-3.5" /></span></summary>
          <p class="qa-body">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
