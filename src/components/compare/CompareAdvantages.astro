---
import type { CompareI18nData } from '../../content.config';
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';

interface Props {
  c: CompareI18nData;
}
const { c } = Astro.props;
const icons = ['phone', 'globe', 'key', 'shield'];
---
<section class="section bg-bg-sunken">
  <div class="container-x">
    <SectionHeader title={c.common.section_titles.moneywise_advantages} />
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-4">
      {c.common.advantages.map((a: { title: string; description: string }, i: number) => (
        <article class="reveal card p-6 flex gap-4">
          <span class="icon-tile shrink-0"><Icon name={icons[i]} /></span>
          <div>
            <h3 class="t-h3 text-fg">{a.title}</h3>
            <p class="t-body mt-1.5">{a.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
