---
import type { CompareI18nData } from '../../content.config';
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';

interface Props {
  c: CompareI18nData;
}
const { c } = Astro.props;
---
<section class="section">
  <div class="container-x grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
    <SectionHeader eyebrow={c.common.ai_deep_dive.eyebrow} title={c.common.ai_deep_dive.title} lead={c.common.ai_deep_dive.description} />
    <ul class="grid gap-3 lg:pt-10">
      {c.common.ai_deep_dive.bullets.map((b: string) => (
        <li class="reveal card p-5 flex gap-3 text-[15px] text-fg">
          <Icon name="sparkles" class="w-5 h-5 shrink-0 text-accent-text mt-0.5" />
          <span>{b}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
