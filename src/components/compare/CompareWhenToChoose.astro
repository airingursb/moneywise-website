---
import type { CompetitorData, CompareI18nData, CompetitorCopy } from '../../content.config';
import { interpolate } from '../../lib/compare';
import SectionHeader from '../SectionHeader.astro';

interface Props {
  self: CompetitorData;
  competitor: CompetitorData;
  c: CompareI18nData;
  copy: CompetitorCopy;
}
const { self, competitor, c, copy } = Astro.props;
const competitorHeading = interpolate(c.common.when_to_choose.competitor_heading_template, {
  competitor: competitor.displayName,
});
---
<section class="section bg-bg-sunken">
  <div class="container-x">
    <SectionHeader title={c.common.section_titles.when_to_choose} />
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-4">
      <article class="reveal card p-7 !border-accent ring-1 ring-accent">
        <h3 class="text-[19px] font-semibold text-accent-text">
          {c.common.when_to_choose.moneywise_heading}
        </h3>
        <p class="mt-3 text-[15.5px] leading-relaxed text-fg">{copy.when_choose_moneywise}</p>
      </article>
      <article class="reveal card p-7">
        <h3 class="text-[19px] font-semibold text-fg">{competitorHeading}</h3>
        <p class="mt-3 text-[15.5px] leading-relaxed text-fg-2">{copy.when_choose_competitor}</p>
      </article>
    </div>
  </div>
</section>
