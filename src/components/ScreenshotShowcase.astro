---
import type { Locale } from '../config/site';
import type { I18nData } from '../content.config';
import type { SlotId } from '../config/screenshots';
import SectionHeader from './SectionHeader.astro';
import Device from './device/Device.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  t: I18nData;
}
const { locale, t } = Astro.props;
const slots = t.screenshots.captions.map((_, i) => `gallery.${i + 1}` as SlotId);
---

<section class="section overflow-hidden" data-gallery>
  <div class="container-x flex items-end justify-between gap-6">
    <SectionHeader eyebrow={t.screenshots.eyebrow} title={t.screenshots.title} />
    <div class="hidden md:flex gap-2 shrink-0">
      <button type="button" data-dir="-1" class="w-11 h-11 rounded-full border border-line-strong bg-bg-elev inline-flex items-center justify-center hover:border-fg-3 transition" aria-label="Previous">
        <Icon name="arrow" class="w-4 h-4 rotate-180" />
      </button>
      <button type="button" data-dir="1" class="w-11 h-11 rounded-full border border-line-strong bg-bg-elev inline-flex items-center justify-center hover:border-fg-3 transition" aria-label="Next">
        <Icon name="arrow" class="w-4 h-4" />
      </button>
    </div>
  </div>
  <div class="scroller mt-12 pb-6" data-track tabindex="0" aria-label={t.screenshots.title}>
    {slots.map((slot, i) => (
      <figure class="w-[13.5rem] sm:w-[15rem]">
        <Device slot={slot} locale={locale} alt={t.screenshots.captions[i]} sizes="240px" />
        <figcaption class="mt-5 text-[14px] leading-snug text-fg-2 pr-2">{t.screenshots.captions[i]}</figcaption>
      </figure>
    ))}
  </div>
  <script is:inline>
    document.querySelectorAll('[data-gallery]').forEach(function (g) {
      var track = g.querySelector('[data-track]');
      g.querySelectorAll('[data-dir]').forEach(function (b) {
        b.addEventListener('click', function () {
          track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.8, behavior: 'smooth' });
        });
      });
    });
  </script>
</section>
