---
import Ph from './Ph.astro';
import type { I18nData } from '../content.config';
import PlatformGrid from './PlatformGrid.astro';

interface Props {
  t: I18nData;
}
const { t } = Astro.props;
---

<section id="download" class="py-6 md:py-10">
  <div class="container-x">
    <div class="relative overflow-hidden rounded-[var(--radius-panel)] bg-ink text-on-ink px-5 py-12 sm:px-10 md:px-14 md:py-16">
      <div aria-hidden="true" class="absolute inset-0 [background:radial-gradient(60%_80%_at_100%_0%,rgba(93,176,121,.28),transparent_60%),radial-gradient(50%_60%_at_0%_100%,rgba(214,180,103,.12),transparent_60%)]"></div>
      <div class="relative grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-10 items-center">
        <div class="reveal">
          <img src="/app-icon.png" alt="" width="56" height="56" class="rounded-[14px] shadow-lg" />
          <h2 class="t-h2 mt-6"><Ph text={t.downloadCta.title} /></h2>
          <p class="t-lead mt-4 !text-on-ink-2">{t.downloadCta.subhead}</p>
        </div>
        <PlatformGrid t={t} tone="ink" />
      </div>
    </div>
  </div>
</section>
