---
import type { Locale } from '../config/site';
import type { I18nData } from '../content.config';
import { pathFor } from '../lib/i18n';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  t: I18nData;
}
const { locale, t } = Astro.props;
const icons = ['phone', 'cloud', 'key'];
---

<section id="privacy" class="section bg-bg-tint">
  <div class="container-x">
    <SectionHeader eyebrow={t.privacyFirst.eyebrow} title={t.privacyFirst.title} lead={t.privacyFirst.subhead} />
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-4">
      {t.privacyFirst.pillars.map((p, i) => (
        <article class="reveal card p-6">
          <span class="icon-tile"><Icon name={icons[i]} /></span>
          <h3 class="t-h3 text-fg mt-5">{p.title}</h3>
          <p class="t-body mt-2">{p.description}</p>
        </article>
      ))}
    </div>
    <a href={pathFor(locale, 'privacy')} class="link-arrow mt-8 text-[15px]">{t.privacyFirst.learn_more}</a>
  </div>
</section>
