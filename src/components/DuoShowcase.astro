---
import type { Locale } from '../config/site';
import type { I18nData } from '../content.config';
import SectionHeader from './SectionHeader.astro';
import Device from './device/Device.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  t: I18nData;
}
const { locale, t } = Astro.props;
const icons = ['fold', 'records', 'sync'];
---

<section id="duo" class="section bg-bg-sunken overflow-hidden">
  <div class="container-x grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-16 items-center">
    <div>
      <SectionHeader eyebrow={t.duo.eyebrow} title={t.duo.title_part1} titleEm={t.duo.title_italic} lead={t.duo.subhead} />
      <ul class="mt-8 space-y-5">
        {t.duo.bullets.map((b, i) => (
          <li class="reveal flex gap-4">
            <span class="icon-tile shrink-0"><Icon name={icons[i]} /></span>
            <div>
              <p class="font-semibold text-fg">{b.title}</p>
              <p class="t-body mt-1">{b.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
    <div class="reveal relative">
      <div aria-hidden="true" class="absolute -inset-10 [background:var(--glow)]"></div>
      <Device slot="duo.main" locale={locale} alt={t.duo.alt} sizes="(min-width: 1024px) 600px, 92vw" class="relative max-w-[40rem] w-[92%]" />
      <Device slot="duo.secondary" locale={locale} alt={t.duo.alt_secondary} sizes="(min-width: 1024px) 360px, 56vw" class="relative z-10 w-[58%] max-w-[24rem] ml-auto -mt-[22%]" />
    </div>
  </div>
</section>
