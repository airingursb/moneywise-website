---
import type { Locale } from '../config/site';
import type { I18nData } from '../content.config';
import SectionHeader from './SectionHeader.astro';
import Device from './device/Device.astro';

interface Props {
  locale: Locale;
  t: I18nData;
}
const { locale, t } = Astro.props;
// Mac captures are landscape and already include the macOS window chrome.
const rest = ['mac.2', 'mac.3', 'mac.4', 'mac.5'] as const;
---

<section id="mac" class="section bg-bg-sunken">
  <div class="container-x">
    <SectionHeader eyebrow={t.mac.eyebrow} title={t.mac.title_part1} titleEm={t.mac.title_italic} titleTail={t.mac.title_part2} lead={t.mac.subhead} />
    <figure class="reveal mt-12">
      <Device slot="mac.1" locale={locale} alt={t.mac.captions[0]} sizes="(min-width: 1216px) 1152px, 94vw" />
      <figcaption class="mt-3 text-[14px] text-fg-3">{t.mac.captions[0]}</figcaption>
    </figure>
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
      {rest.map((slot, i) => (
        <figure class="reveal">
          <Device slot={slot} locale={locale} alt={t.mac.captions[i + 1]} sizes="(min-width: 1216px) 560px, (min-width: 640px) 46vw, 94vw" />
          <figcaption class="mt-3 text-[14px] text-fg-3">{t.mac.captions[i + 1]}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
