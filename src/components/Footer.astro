---
import type { Locale } from '../config/site';
import type { I18nData } from '../content.config';
import { SITE } from '../config/site';
import { pathFor } from '../lib/i18n';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props {
  locale: Locale;
  slug: string;
  t: I18nData;
}
const { locale, slug, t } = Astro.props;
const cols = [
  {
    title: t.footer.product,
    links: [
      { href: pathFor(locale, 'features'), label: t.nav.features },
      { href: `${pathFor(locale)}#pricing`, label: t.nav.pricing },
      { href: pathFor(locale, 'compare'), label: t.footer.compare },
      { href: `${pathFor(locale)}#download`, label: t.nav.download },
    ],
  },
  {
    title: t.footer.support,
    links: [
      { href: pathFor(locale, 'help'), label: t.nav.help },
      { href: pathFor(locale, 'faq'), label: t.nav.faq },
      { href: pathFor(locale, 'account-deletion'), label: t.footer.account_deletion },
      { href: `mailto:${SITE.contactEmail}`, label: t.footer.contact },
    ],
  },
  {
    title: t.footer.legal,
    links: [
      { href: pathFor(locale, 'privacy'), label: t.nav.privacy },
      { href: pathFor(locale, 'terms'), label: t.footer.terms },
      { href: SITE.githubUrl, label: 'GitHub' },
    ],
  },
];
---

<footer class="border-t border-line bg-bg-sunken">
  <div class="container-x py-14 md:py-16 grid grid-cols-2 md:grid-cols-[1.4fr_1fr_1fr_1fr] gap-x-6 gap-y-10">
    <div class="col-span-2 md:col-span-1">
      <a href={pathFor(locale)} class="inline-flex items-center gap-2.5">
        <img src="/app-icon.png" alt="" width="30" height="30" class="rounded-[8px]" />
        <span class="text-[16px] font-semibold tracking-[-0.01em]">MoneyWise</span>
      </a>
      <p class="mt-4 text-[14px] leading-relaxed text-fg-2 max-w-[280px]">{t.footer.tagline}</p>
      <a href={`mailto:${SITE.contactEmail}`} class="mt-4 inline-block text-[14px] text-fg-2 hover:text-accent-text break-all">{SITE.contactEmail}</a>
    </div>
    {cols.map((c) => (
      <div>
        <p class="text-[12px] uppercase tracking-[0.12em] font-semibold text-fg-3">{c.title}</p>
        <ul class="mt-4 space-y-2.5 text-[14px]">
          {c.links.map((l) => (
            <li><a href={l.href} class="text-fg-2 hover:text-fg transition">{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="container-x pb-10 flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-4 text-[13px] text-fg-3">
    <span>{t.footer.copyright}</span>
    <LocaleSwitcher current={locale} slug={slug} placement="up" />
  </div>
</footer>
