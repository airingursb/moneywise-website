---
import type { I18nData } from '../content.config';
import { PRICING } from '../config/site';
import AppStoreBadge from './AppStoreBadge.astro';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';

interface Props {
  t: I18nData;
}
const { t } = Astro.props;

const fmt = (n: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: PRICING.pro.currency, minimumFractionDigits: 2 }).format(n);
---

<section id="pricing" class="section">
  <div class="container-x">
    <SectionHeader eyebrow={t.pricing.eyebrow} title={t.pricing.title} lead={t.pricing.subhead} align="center" />
    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-4 max-w-[56rem] mx-auto">
      <article class="reveal card p-7 md:p-8 flex flex-col">
        <h3 class="text-[20px] font-semibold text-fg">{t.pricing.free_name}</h3>
        <p class="mt-1.5 text-[14px] text-fg-2">{t.pricing.free_tagline}</p>
        <div class="mt-6 flex items-baseline gap-2">
          <span class="t-num text-[44px] font-semibold text-fg leading-none">$0</span>
        </div>
        <ul class="mt-7 pt-6 border-t border-line space-y-3 flex-1">
          {t.pricing.free_features.map((f) => (
            <li class="flex gap-3 text-[14.5px] text-fg">
              <Icon name="check" class="w-4 h-4 mt-1 shrink-0 text-accent-text" />
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <AppStoreBadge variant="light" label={t.pricing.cta_free} comingSoonLabel={t.hero.coming_soon} />
        </div>
      </article>

      <article class="reveal relative rounded-[var(--radius-card)] p-7 md:p-8 flex flex-col bg-ink text-on-ink shadow-[var(--shadow-md)] overflow-hidden">
        <div aria-hidden="true" class="absolute -top-24 -right-24 w-72 h-72 rounded-full [background:radial-gradient(circle,rgba(93,176,121,.35),transparent_70%)]"></div>
        <div class="relative flex items-center justify-between gap-3">
          <h3 class="text-[20px] font-semibold">{t.pricing.pro_name}</h3>
          <span class="rounded-full bg-accent-on-ink/15 text-accent-on-ink text-[12px] font-semibold px-3 py-1">{t.pricing.free_trial}</span>
        </div>
        <p class="relative mt-1.5 text-[14px] text-on-ink-2">{t.pricing.pro_tagline}</p>
        <div class="relative mt-6 flex items-baseline gap-2">
          <span class="t-num text-[44px] font-semibold leading-none">{fmt(PRICING.pro.priceAnnual)}</span>
          <span class="text-[14px] text-on-ink-2">{t.pricing.per_year}</span>
        </div>
        <p class="relative mt-2 text-[13px] text-on-ink-2">
          {t.pricing.or_monthly_prefix}{fmt(PRICING.pro.priceMonthly)}{t.pricing.per_month}
        </p>
        <ul class="relative mt-7 pt-6 border-t border-line-on-ink space-y-3 flex-1">
          {t.pricing.pro_features.map((f) => (
            <li class="flex gap-3 text-[14.5px]">
              <Icon name="check" class="w-4 h-4 mt-1 shrink-0 text-accent-on-ink" />
              <span>{f}</span>
            </li>
          ))}
        </ul>
        <div class="relative mt-8">
          <AppStoreBadge variant="accent" label={t.pricing.cta_pro} comingSoonLabel={t.hero.coming_soon} class="!bg-[#8FD3A5] !text-[#06130B] hover:!bg-[#a5dfb7]" />
        </div>
      </article>
    </div>
  </div>
</section>
