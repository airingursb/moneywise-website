---
import type { Locale } from '../config/site';
import type { I18nData } from '../content.config';
import PlatformGrid from './PlatformGrid.astro';
import Device from './device/Device.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  t: I18nData;
}
const { locale, t } = Astro.props;
---

<section class="relative overflow-hidden">
  <!-- soft brand wash -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 right-[-20%] w-[70rem] h-[50rem] [background:var(--glow)] opacity-90"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-bg"></div>
  </div>

  <div class="container-x pt-10 pb-16 md:pt-16 md:pb-24 lg:pt-20 grid grid-cols-1 lg:grid-cols-[1.08fr_1fr] gap-12 lg:gap-8 items-center">
    <div class="max-w-[38rem]">
      <a href="#whats-new" class="pill hover:border-line-strong transition" data-umami-event="hero_whats_new_click">
        <span class="pill-tag">{t.hero.badge_new}</span>
        <span class="truncate">{t.hero.badge_text}</span>
        <Icon name="arrow" class="w-3.5 h-3.5 shrink-0 text-fg-3" />
      </a>

      <h1 class="t-display mt-6">
        {t.hero.headline_part1}
        <span class="block t-serif">{t.hero.headline_italic}</span>
      </h1>
      <p class="t-lead mt-6 max-w-[34rem]">{t.hero.subhead}</p>

      <PlatformGrid t={t} layout="compact" class="mt-8" />

      <dl class="mt-10 pt-6 border-t border-line grid grid-cols-3 gap-4 max-w-[30rem]">
        <div>
          <dt class="sr-only">{t.hero.stat_offline_label}</dt>
          <dd class="t-num text-[22px] md:text-[26px] font-semibold text-fg">100%</dd>
          <dd class="mt-1 text-[12px] leading-snug text-fg-3">{t.hero.stat_offline_label}</dd>
        </div>
        <div>
          <dt class="sr-only">{t.hero.stat_ads_label}</dt>
          <dd class="t-num text-[22px] md:text-[26px] font-semibold text-fg">0</dd>
          <dd class="mt-1 text-[12px] leading-snug text-fg-3">{t.hero.stat_ads_label}</dd>
        </div>
        <div>
          <dt class="sr-only">{t.hero.stat_byok_label}</dt>
          <dd class="t-num text-[22px] md:text-[26px] font-semibold text-fg">BYOK</dd>
          <dd class="mt-1 text-[12px] leading-snug text-fg-3">{t.hero.stat_byok_label}</dd>
        </div>
      </dl>
      <a href="#features" data-umami-event="hero_secondary_click" class="link-arrow mt-6 text-[14px]">
        {t.hero.cta_secondary}<Icon name="arrow" class="w-4 h-4" />
      </a>
    </div>

    <!-- Device stage: iPhone (front), iPhone (back), Apple Watch -->
    <div class="relative mx-auto w-full max-w-[30rem] lg:max-w-none">
      <div class="relative mx-auto w-[min(100%,27rem)] aspect-[1/1.12]">
        <div class="absolute left-[5%] top-[9%] w-[42%] hero-back">
          <Device slot="hero.iphone-back" locale={locale} alt={t.screenshots.captions[4]} sizes="(min-width: 1024px) 200px, 40vw" />
        </div>
        <div class="absolute left-[30%] top-0 w-[50%] hero-front">
          <Device slot="hero.iphone" locale={locale} alt={t.screenshots.captions[0]} sizes="(min-width: 1024px) 230px, 48vw" eager />
        </div>
        <div class="absolute right-[0%] bottom-[2%] w-[27%] hero-watch">
          <Device slot="hero.watch" locale={locale} alt={t.watch.alt_primary} sizes="(min-width: 1024px) 130px, 26vw" eager />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-back { transform: rotate(-7deg); opacity: .95; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-front { animation: hero-rise 1s var(--ease-out-soft) both; }
    .hero-back { animation: hero-rise-back 1.1s .1s var(--ease-out-soft) both; }
    .hero-watch { animation: hero-rise 1.1s .25s var(--ease-out-soft) both; }
  }
  @keyframes hero-rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  @keyframes hero-rise-back { from { opacity: 0; transform: translateY(24px) rotate(-7deg); } to { opacity: .95; transform: rotate(-7deg); } }
</style>
