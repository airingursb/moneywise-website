---
import type { I18nData } from '../content.config';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';

interface Props {
  t: I18nData;
}
const { t } = Astro.props;
const icons = ['dashboard', 'records', 'wallet', 'chart', 'pie', 'sparkles'];
---

<section id="features" class="section !pt-6 md:!pt-8">
  <div class="container-x">
    <SectionHeader eyebrow={t.features.eyebrow} title={t.features.title} />
    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {t.features.items.map((item, i) => (
        <article class="reveal card card-hover p-6 flex sm:flex-col gap-4">
          <span class="icon-tile shrink-0"><Icon name={icons[i]} /></span>
          <div>
            <h3 class="t-h3 text-fg">{item.title}</h3>
            <p class="t-body mt-1.5">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
