---
import type { Locale } from '../config/site';
import type { I18nData } from '../content.config';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  t: I18nData;
}
const { t } = Astro.props;
const icons = ['server', 'key', 'plug'];
---

<section id="extensions" class="section">
  <div class="container-x grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-12 lg:gap-16">
    <div>
      <SectionHeader eyebrow={t.extensions.eyebrow} title={t.extensions.title_part1} titleEm={t.extensions.title_italic} titleTail={t.extensions.title_part2} lead={t.extensions.subhead} />
      <div class="reveal mt-8 flex flex-wrap items-center gap-2">
        <span class="text-[12px] uppercase tracking-[0.12em] text-fg-3 font-semibold mr-1">{t.extensions.clients_label}</span>
        {t.extensions.clients.map((c) => (
          <span class="inline-flex items-center rounded-full border border-line bg-bg-elev px-3 py-1.5 text-[13px] text-fg-2">{c}</span>
        ))}
      </div>
    </div>
    <div class="grid gap-4">
      {t.extensions.pillars.map((p, i) => (
        <article class="reveal card p-6 flex gap-4">
          <span class="icon-tile shrink-0"><Icon name={icons[i]} /></span>
          <div>
            <h3 class="t-h3 text-fg">{p.title}</h3>
            <p class="t-body mt-1.5">{p.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
