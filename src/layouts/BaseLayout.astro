---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import { SITE } from '../config/site';
import type { Locale } from '../config/site';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  slug?: string;
}

const { title, description, locale, slug = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAF9F5" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B100D" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {SITE.searchConsoleVerification && (
      <meta name="google-site-verification" content={SITE.searchConsoleVerification} />
    )}
    <SeoHead title={title} description={description} locale={locale} slug={slug} />
    <slot name="head" />
    <script
      is:inline
      defer
      src={SITE.umamiScriptUrl}
      data-website-id={SITE.umamiWebsiteId}
    ></script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaMeasurementId}`}></script>
    <script is:inline define:vars={{ gaId: SITE.gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
    <script is:inline>
      (function() {
        function identify() {
          if (typeof umami === 'undefined' || typeof umami.identify !== 'function') return;
          var lang = document.documentElement.lang || 'en';
          var visited = localStorage.getItem('mw_visited');
          var returning = visited ? 'yes' : 'no';
          if (!visited) localStorage.setItem('mw_visited', '1');
          umami.identify({ language: lang, returning: returning });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function () { setTimeout(identify, 500); });
        } else {
          setTimeout(identify, 500);
        }
      })();
    </script>
  </head>
  <body class="bg-bg text-fg">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] btn btn-primary">Skip to content</a>
    <slot />
    <script is:inline>
      // Fade-up reveal for `.reveal` elements. Content is visible without JS
      // (the `.js` class gates the hidden state) and under reduced motion.
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('is-in'); }); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach(function (e) { io.observe(e); });
      })();
    </script>
  </body>
</html>
