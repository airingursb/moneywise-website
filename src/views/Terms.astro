---
import type { Locale } from '../config/site';
import { getI18n } from '../lib/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LegalShell from '../components/LegalShell.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = await getI18n(locale);

const termsDocs = import.meta.glob('../content/legal/terms-*.md');
const key = `../content/legal/terms-${locale}.md`;
const loader = termsDocs[key] ?? termsDocs['../content/legal/terms-en.md'];
const { Content } = await (loader as () => Promise<any>)();
---

<BaseLayout title={`Terms of Service · MoneyWise`} description="Terms governing use of MoneyWise." locale={locale} slug="terms">
  <Nav locale={locale} slug="terms" t={t} />
  <LegalShell eyebrow={t.footer.terms}>
    <Content />
  </LegalShell>
  <Footer locale={locale} slug="terms" t={t} />
</BaseLayout>
